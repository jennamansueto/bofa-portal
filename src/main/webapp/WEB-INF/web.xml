<?xml version="1.0" encoding="ISO-8859-1"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

  <display-name>OLB Transfers Portal</display-name>

  <context-param>
    <param-name>olb.jdbc.url</param-name>
    <param-value>jdbc:hsqldb:mem:olbp01</param-value>
  </context-param>
  <context-param>
    <param-name>olb.jdbc.driver</param-name>
    <param-value>org.hsqldb.jdbcDriver</param-value>
  </context-param>
  <context-param>
    <param-name>olb.jdbc.user</param-name>
    <param-value>sa</param-value>
  </context-param>
  <context-param>
    <param-name>olb.jdbc.password</param-name>
    <param-value></param-value>
  </context-param>
  <context-param>
    <param-name>olb.cutoff.hour</param-name>
    <param-value>20</param-value>
  </context-param>

  <listener>
    <listener-class>com.bankofamerica.olb.web.StartupListener</listener-class>
  </listener>

  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.bankofamerica.olb.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/secure/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
    <init-param>
      <param-name>config</param-name>
      <param-value>/WEB-INF/struts-config.xml</param-value>
    </init-param>
    <load-on-startup>2</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>10</session-timeout>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>

</web-app>
